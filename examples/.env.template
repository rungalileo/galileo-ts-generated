# galileo-generated SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: GALILEOGENERATED_
#
# Security environment variables:
GALILEOGENERATED_API_KEY_HEADER=your_apikeyheader_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
GALILEOGENERATED_DEBUG=true
