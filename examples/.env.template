# galileo-generated SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: GALILEOGENERATED_
#
# Security environment variables:
GALILEOGENERATED_USERNAME=your_username_here
GALILEOGENERATED_PASSWORD=your_password_here
GALILEOGENERATED_CLIENT_ID=your_client_id_here
GALILEOGENERATED_CLIENT_SECRET=your_client_secret_here
GALILEOGENERATED_TOKEN_URL=https://example.com/oauth/token
GALILEOGENERATED_TOKEN=your_token_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
GALILEOGENERATED_DEBUG=true
